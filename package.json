{
  "name": "frateli-lms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && npm run build:worker",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --target=node22 --outfile=dist/worker/index.js --external:@node-rs/argon2 --external:pg-native",
    "build:scripts": "esbuild src/db/migrate.ts --bundle --platform=node --target=node22 --outfile=dist/db/migrate.js --external:@node-rs/argon2 --external:pg-native",
    "start": "node server.js",
    "start:worker": "node dist/worker/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@google/genai": "^2.30.0",
    "@node-rs/argon2": "^2.0.2",
    "bullmq": "^5.45.0",
    "googleapis": "^148.0.0",
    "ioredis": "^5.6.0",
    "lucide-react": "^0.483.0",
    "marked": "^15.0.7",
    "next": "^15.3.0",
    "nodemailer": "^6.10.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.14.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.15.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sanitize-html": "^2.13.0",
    "esbuild": "^0.25.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
