# ==============================================================================
# Frateli LMS — Variables de Entorno (Copiar a .env en local o configurar en EasyPanel Runtime)
# NUNCA commitear valores reales al repositorio Git.
# ==============================================================================

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
HOSTNAME=0.0.0.0

# PostgreSQL 16 (En EasyPanel usar DNS interno: frateli_fratelipostgres)
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/frateli?sslmode=disable
PG_POOL_MAX=10

# Redis 7 (En EasyPanel usar DNS interno: frateli_redisfrateli)
# Si usas 1 sola instancia Redis en EasyPanel, define REDIS_URL y deja opcionales QUEUE/CACHE
REDIS_URL=redis://default:CHANGE_ME@localhost:6379
# REDIS_QUEUE_URL=
# REDIS_CACHE_URL=

# Seguridad de Sesión y Cifrado de Integraciones (Generar con: openssl rand -hex 32)
SESSION_SECRET=replace-with-64-hex-characters-minimum-32-bytes-long-secret-key
INTEGRATION_ENCRYPTION_KEY=replace-with-64-hex-characters-for-aes-256-gcm-token-encryption

# Superadministrador inicial (se crea automáticamente al arrancar si no existe ningún superadmin)
BOOTSTRAP_ADMIN_EMAIL=admin@frateli.edu
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisStrongPassword123!
BOOTSTRAP_ADMIN_NAME=Superadmin Frateli

# Almacenamiento Dual ('local' para arrancar con volumen EasyPanel, 's3' para Cloudflare R2)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=/var/lib/frateli/media

# Cloudflare R2 (Requerido solo cuando STORAGE_DRIVER=s3)
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=frateli-media-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Correo Google SMTP con Clave de Aplicación (desde la misma app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM="Frateli Campus <notifications@frateli.edu>"
SMTP_DAILY_LIMIT=450

# Apoyo de IA — Gemini API (@google/genai)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Herramientas de Google (Drive, Docs, Slides, Sheets, Calendar) — OAuth 2.0
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Worker FFmpeg (límites seguros para Hostinger KVM 2)
FFMPEG_CONCURRENCY=1
FFMPEG_THREADS=1
FFMPEG_TMP_DIR=/tmp/frateli-transcode
